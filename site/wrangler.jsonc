{
  // Static site for clacket.th33raphat.dev. Built by scripts/build-site.sh into ./dist.
  "name": "clacket-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
