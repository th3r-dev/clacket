<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Notarization requires the hardened runtime, under which WKWebView can't run its
       JavaScript JIT without this. Omit it and the settings window renders a blank page on
       notarized builds. Input Monitoring is a TCC permission, not an entitlement, so it
       needs nothing here. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
