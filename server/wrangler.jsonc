{
  "name": "clacket-license",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "clacket-license", "database_id": "REPLACE_AFTER_d1_create", "migrations_dir": "migrations" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "RECOVER_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "FROM_EMAIL": "keys@REPLACE_YOUR_DOMAIN", "APP_NAME": "Clacket" }
  // secrets (wrangler secret put): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, LICENSE_SIGNING_KEY
}
